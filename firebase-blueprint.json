{
  "entities": {
    "transaction": {
      "title": "Transaction",
      "description": "Financial transaction ledger entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "amount": { "type": "number" },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "mode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "referenceNumber": { "type": "string", "minLength": 1, "maxLength": 128 },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "date", "description", "amount", "type", "createdAt", "updatedAt"]
    },
    "application": {
      "title": "Application",
      "description": "Loan origination application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "submittedDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "amount", "status", "submittedDate", "createdAt", "updatedAt"]
    },
    "salesInvoice": {
      "title": "Sales Invoice",
      "description": "Receivable sales invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "amount": { "type": "number" },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "customer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "invoiceNumber", "date", "amount", "status", "createdAt", "updatedAt"]
    },
    "purchaseBill": {
      "title": "Purchase Bill",
      "description": "Payable vendor purchase bill",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "billNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "amount": { "type": "number" },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "billNumber", "date", "amount", "status", "createdAt", "updatedAt"]
    },
    "adminRecord": {
      "title": "Admin Record",
      "description": "Verified platform administrator registry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "branch": {
      "title": "HQ Branch Node",
      "description": "Normalized branch entity synchronized with centralized HQ server",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "region": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hqSyncMode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "syncStatus": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "branchCode", "name", "syncStatus", "createdAt", "updatedAt"]
    },
    "moduleEntitlement": {
      "title": "SaaS Module Entitlement",
      "description": "Per-client-bank activation/deactivation entitlement matrix",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "preset": { "type": "string", "minLength": 1, "maxLength": 64 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "preset", "createdAt", "updatedAt"]
    },
    "backupSnapshot": {
      "title": "Backup Snapshot",
      "description": "SHA-256 verified recovery checkpoint metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "totalRecords": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "label", "sha256", "totalRecords", "createdAt", "updatedAt"]
    },
    "migrationBatch": {
      "title": "Migration Batch",
      "description": "Audit log for atomic ETL migration and rollback batches",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetEntity": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "insertedRows": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "targetEntity", "status", "insertedRows", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Financial transactions collection"
    },
    "/applications/{applicationId}": {
      "schema": "application",
      "description": "Loan applications collection"
    },
    "/salesInvoices/{invoiceId}": {
      "schema": "salesInvoice",
      "description": "Sales invoices collection"
    },
    "/purchaseBills/{billId}": {
      "schema": "purchaseBill",
      "description": "Purchase bills collection"
    },
    "/admins/{userId}": {
      "schema": "adminRecord",
      "description": "Verified administrator role registry"
    },
    "/branches/{branchId}": {
      "schema": "branch",
      "description": "HQ synchronized regional branches"
    },
    "/moduleEntitlements/{tenantId}": {
      "schema": "moduleEntitlement",
      "description": "SaaS module activation states per client bank"
    },
    "/backupSnapshots/{snapshotId}": {
      "schema": "backupSnapshot",
      "description": "Verified database snapshot metadata"
    },
    "/migrationBatches/{batchId}": {
      "schema": "migrationBatch",
      "description": "Atomic migration audit log"
    }
  }
}
